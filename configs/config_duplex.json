    "filter_by_hairpin": true,
    "max_hairpin_tm": 30.0,
    "filter_by_arm_dimer": true,
    "max_arm_dimer_dg": -1.0,
    "blastdbDir": "blastdb",
    "threads": 32,
    "blastMinIdentity": 70.0,
    "maxAllowedHits": 0,
