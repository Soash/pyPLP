      "probe_binding_len": 15,
      "rest_len": 4,
      "restriction_site": "BstUI",
      "universal_rca_primer_seq": "",
      "universal_probe_seq": "",
      "min_rca_primer_tm": 40.0,
      "min_probe_tm": 40.0
    }
  },
  "multiplex": {
    "target_channels": 2,
    "max_cross_dimer_dg": -2.0,
    "channel_labels": ["5'-Biotin", "5'-DIG"],
    "universal_detection_probe": "",
    "fixed_oligos": ""
